{
  "name": "website-mcp-server",
  "version": "0.1.0",
  "description": "MCP server to share professional information with LLMs",
  "author": "Anthuan Vasquez <me@anthuanvasquez.net>",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "server",
    "website",
    "profile"
  ],
  "license": "ISC",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "watch": "tsx watch src/main.ts",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector node dist/main.js",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.7.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^4.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.0.18"
  }
}
